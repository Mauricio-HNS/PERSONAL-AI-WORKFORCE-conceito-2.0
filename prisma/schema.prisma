generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Agent {
  id               String   @id
  name             String
  role             String
  systemPrompt     String
  autonomyDefault  String
  allowedTools     String
  status           String   @default("active")
  tasks            Task[]
  actions          Action[]
  opportunities    Opportunity[]
}

model Task {
  id          String    @id @default(cuid())
  userInput   String
  agentId     String
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  agent       Agent     @relation(fields: [agentId], references: [id])
  actions     Action[]
  opportunities Opportunity[]
}

model Action {
  id               String     @id @default(cuid())
  taskId           String
  agentId          String
  description      String
  autonomyLevel    String
  requiresApproval Boolean    @default(false)
  approved         Boolean?
  executedAt       DateTime?
  result           String?
  task             Task       @relation(fields: [taskId], references: [id])
  agent            Agent      @relation(fields: [agentId], references: [id])
  auditLogs        AuditLog[]
}

model AuditLog {
  id        String   @id @default(cuid())
  actionId  String?
  actor     String
  event     String
  payload   String
  timestamp DateTime @default(now())
  action    Action? @relation(fields: [actionId], references: [id])
}

model Opportunity {
  id             String    @id @default(cuid())
  title          String
  category       String
  description    String
  estimatedValue Float
  confidence     Float
  status         String    @default("detected")
  source         String
  evidence       String
  createdAt      DateTime  @default(now())
  verifiedValue  Float?
  agentId        String
  taskId         String?
  agent           Agent    @relation(fields: [agentId], references: [id])
  task            Task?    @relation(fields: [taskId], references: [id])
}
